{
  "id": "footer-identity",
  "installPath": "plugins/user/footer/identity/footer-identity",
  "name": "Footer identity",
  "version": "1.0.0",
  "kind": "generic",
  "description": "Shop name, tagline and copyright in the footer identity slot. Operator-owned copy.",
  "defaultEnabled": true,
  "provides": [
    "StorefrontSlot"
  ],
  "defaultSettings": {
    "shopName": "Shop",
    "tagline": "",
    "alsoKnownAs": "",
    "copyrightSuffix": ""
  },
  "settingsSchema": {
    "shopName": {
      "type": "string",
      "label": "Shop name"
    },
    "tagline": {
      "type": "text",
      "label": "Tagline"
    },
    "alsoKnownAs": {
      "type": "string",
      "label": "Also known as"
    },
    "copyrightSuffix": {
      "type": "string",
      "label": "Copyright suffix"
    }
  },
  "engines": {
    "core": ">=0.0.1 <1.0.0"
  }
}
