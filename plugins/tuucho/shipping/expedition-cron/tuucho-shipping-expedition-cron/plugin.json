{
  "id": "tuucho-shipping-expedition-cron",
  "installPath": "plugins/tuucho/shipping/expedition-cron/tuucho-shipping-expedition-cron",
  "name": "Expedition cron",
  "version": "1.0.0",
  "kind": "generic",
  "description": "Scheduled shipment tracking. Complements home and Mondial Relay shipping. Disable to stop expedition cron work.",
  "defaultEnabled": false,
  "dependsOnMode": "any",
  "dependsOn": [
    {
      "id": "tuucho-shipping-home",
      "version": ">=1.0.0"
    },
    {
      "id": "tuucho-shipping-mondial-relay",
      "version": ">=1.0.0"
    }
  ],
  "provides": [
    "CronJob"
  ],
  "engines": {
    "core": ">=1.0.0 <2.0.0"
  }
}
