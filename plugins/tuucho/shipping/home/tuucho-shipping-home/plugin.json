{
  "id": "tuucho-shipping-home",
  "installPath": "plugins/tuucho/shipping/home/tuucho-shipping-home",
  "name": "Home address delivery",
  "version": "1.0.0",
  "kind": "shipping",
  "description": "Delivery to a home address. Packet prices are editable in Admin, Plugins.",
  "defaultEnabled": true,
  "provides": [
    "ShippingMethod"
  ],
  "courierCodes": [
    "colissimo-home",
    "chronopost-home",
    "mondial-relay-home"
  ],
  "engines": {
    "core": ">=0.0.1 <1.0.0"
  }
}
