{
  "name": "@tuucho/plugin-tuucho-seo-redirects",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Applies stored SEO redirects and plugin redirect rules on the shop API host.",
  "tuucho": {
    "id": "tuucho-seo-redirects",
    "installPath": "plugins/tuucho/seo/redirects/tuucho-seo-redirects",
    "name": "Redirects apply",
    "kind": "seo",
    "defaultEnabled": true,
    "provides": [
      "SeoRedirects"
    ],
    "permissions": [
      {
        "code": "seo_redirects",
        "label": "SEO redirects"
      }
    ],
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    }
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../../plugin-sdk"
  }
}
