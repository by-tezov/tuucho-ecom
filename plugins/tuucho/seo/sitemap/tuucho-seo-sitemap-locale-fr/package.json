{
  "name": "@tuucho/plugin-tuucho-seo-sitemap-locale-fr",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "French strings for seo-sitemap. Enable with locale-fr for French UI; disable to keep this plugin in English.",
  "tuucho": {
    "id": "tuucho-seo-sitemap-locale-fr",
    "installPath": "plugins/tuucho/seo/sitemap/tuucho-seo-sitemap-locale-fr",
    "name": "seo-sitemap French",
    "kind": "locale",
    "defaultEnabled": true,
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "dependsOn": [
      {
        "id": "tuucho-seo-sitemap",
        "version": ">=1.0.0"
      }
    ],
    "provides": [
      "Locale"
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../../plugin-sdk"
  }
}
