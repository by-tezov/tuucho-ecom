{
  "name": "@tuucho/plugin-tuucho-page-home",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Storefront home at /home. Featured, FAQ and onboarding stay slots. Not required.",
  "tuucho": {
    "id": "tuucho-page-home",
    "installPath": "plugins/tuucho/page/home/tuucho-page-home",
    "name": "Home",
    "kind": "page",
    "required": false,
    "defaultEnabled": true,
    "provides": [
      "StorefrontPage"
    ],
    "route": "/home",
    "nav": {
      "key": "home",
      "order": 10,
      "bottomBar": true
    },
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    }
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../../plugin-sdk"
  }
}
