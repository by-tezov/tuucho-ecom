{
  "name": "@tuucho/plugin-tuucho-journal-api-locale-fr",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "French strings for journal-api. Enable with locale-fr for French UI; disable to keep this plugin in English.",
  "tuucho": {
    "id": "tuucho-journal-api-locale-fr",
