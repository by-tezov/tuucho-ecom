{
  "name": "tuucho-ecom",
  "private": true,
  "version": "0.0.4",
  "description": "Self-hosted batteries-included e-commerce platform: kernel plus bundled plugins.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "tuucho/plugin-sdk",
    "tuucho/kernel/back",
    "tuucho/kernel/front",
    "tuucho/plugins/**",
    "src/plugins/**"
  ],
  "dependencies": {
    "canvas": "^3.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.1"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "setup:cli": "node scripts/install.mjs --yes",
    "dev": "node scripts/dev.mjs",
    "dev:back": "npm --prefix tuucho/kernel/back run dev",
    "dev:front": "npm --prefix tuucho/kernel/front run dev -- --port 5174 --strictPort"
  }
}
