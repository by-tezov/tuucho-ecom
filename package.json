{
  "name": "tezov-ecommerce",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source single-shop e-commerce with a WordPress-style installer and plugin runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "setup:cli": "node scripts/install.mjs --yes",
    "dev": "node scripts/dev.mjs",
    "dev:back": "npm --prefix back run dev",
    "dev:front": "npm --prefix front run dev -- --port 5174 --strictPort"
  }
}
