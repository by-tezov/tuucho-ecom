{
  "paths": {
    "publicDir": "./output/public",
    "privateDir": "./output/private",
    "devDir": "./output/dev",
    "devEmailUserDir": "/email-user"
  },
  "http": {
    "publicMediaUrl": "http://localhost:3010/media",
    "apiBaseUrl": "http://localhost:3010",
    "frontendBaseUrl": "http://localhost:5174"
  },
  "auth": {
    "disableOtpCooldown": true,
    "otpCooldown": "1m",
    "otpMaxAttempts": 100000,
    "otpVerifyDelay": "1ms"
  },
  "smtp": {
    "fromNamePrefix": "Dev:",
    "port": ""
  },
  "rateLimits": {
    "ops": "60s:100000",
    "auth": "60s:1000",
    "authRefresh": "60s:1000",
    "disableAuth": true,
    "disableAuthRefresh": true,
    "disableCheckout": true,
    "disablePayment": true,
    "disableGallery": true,
    "disableOps": true,
    "disableLogin": true,
    "disableInvoiceDownload": true,
    "disableInvoiceEmail": true
  },
  "email": {
    "disableConfirmationResendCooldown": true,
    "disableChangeCooldown": true,
    "confirmationResendCooldown": "2m",
    "changeCooldown": "5m"
  },
  "security": {
    "loginLockout": "1s:1000",
    "passwordResetLimit": "100000:100000"
  }
}
