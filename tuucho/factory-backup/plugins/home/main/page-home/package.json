{
  "name": "@tuucho/plugin-page-home",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Storefront home at /home. Featured, FAQ and onboarding stay slots. Not required.",
  "tuucho": {
    "id": "page-home",
    "installPath": "src/plugins/home/main/page-home",
    "name": "Home",
    "required": false,
    "defaultEnabled": true,
    "provides": [
      "StorefrontPage"
    ],
    "route": "/home",
    "nav": {
      "key": "home",
      "order": 10,
      "bottomBar": true
    },
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "kinds": [
      "page"
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../../tuucho/plugin-sdk"
  }
}
