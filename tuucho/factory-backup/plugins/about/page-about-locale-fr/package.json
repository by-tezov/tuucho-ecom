{
  "name": "@tuucho/plugin-page-about-locale-fr",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "French strings for page-about. Enable with locale-fr for French UI; disable to keep this plugin in English.",
  "tuucho": {
    "id": "page-about-locale-fr",
