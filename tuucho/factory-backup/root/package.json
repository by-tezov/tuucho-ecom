{
  "name": "tuucho-ecom",
  "private": true,
  "version": "0.0.9",
  "description": "Self-hosted batteries-included e-commerce platform: kernel plus bundled plugins.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "tuucho/plugin-sdk",
    "tuucho/kernel/back",
    "tuucho/kernel/front",
    "tuucho/plugins/**",
    "src/plugins/**"
  ],
  "dependencies": {
    "canvas": "^3.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.1"
  },
  "scripts": {
    "setup": "node tuucho/scripts/install.mjs",
    "setup:cli": "node tuucho/scripts/install.mjs --yes",
    "dev": "node tuucho/scripts/dev.mjs",
    "dev:back": "npm --prefix tuucho/kernel/back run dev",
    "dev:front": "npm --prefix tuucho/kernel/front run dev -- --port 5174 --strictPort",
    "versioning": "node tuucho/scripts/tuucho-versioning.mjs",
    "versioning:check": "node tuucho/scripts/tuucho-versioning.mjs --check",
    "factory-sync": "node tuucho/scripts/factory-sync.mjs",
    "factory-sync:check": "node tuucho/scripts/factory-sync.mjs --check",
    "config:migrate": "npm --prefix tuucho/kernel/back run config:migrate",
    "config:doctor": "npm --prefix tuucho/kernel/back run config:doctor",
    "config:env": "npm --prefix tuucho/kernel/back run config:env",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"tuucho/**/*.{ts,tsx,css,mjs,json,md}\" \"src/**/*.{ts,tsx,css,json,md}\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"tuucho/**/*.{ts,tsx,css,mjs,json,md}\" \"src/**/*.{ts,tsx,css,json,md}\" \"*.{ts,mjs,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
