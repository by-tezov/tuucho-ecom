{
  "name": "@tuucho/plugin-tuucho-commerce-cart-rules",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Thresholds, gifts and other cart alterations. Disable to hide admin and checkout effects.",
  "tuucho": {
    "id": "tuucho-commerce-cart-rules",
    "installPath": "tuucho/plugins/commerce/cart-rules/tuucho-commerce-cart-rules",
    "name": "Cart rules",
    "kind": "commerce",
    "defaultEnabled": true,
    "provides": [
      "CheckoutAlteration",
      "AdminPage"
    ],
    "permissions": [
      {
        "code": "cart_rules",
        "label": "Cart rules"
      }
    ],
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "adminNav": [
      {
        "id": "cart-rules",
        "group": "commerce",
        "to": "/cart-rules",
        "permission": "cart_rules",
        "order": 20,
        "label": "Cart rules"
      }
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../plugin-sdk"
  }
}
