{
  "name": "@tuucho/plugin-tuucho-locale-fr",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Kernel French for admin and storefront chrome. Enable to offer French in the language switcher. Disable for English-only kernel UI.",
  "tuucho": {
    "id": "tuucho-locale-fr",
    "installPath": "tuucho/plugins/locale/tuucho-locale-fr",
    "name": "French",
    "kind": "locale",
    "defaultEnabled": true,
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "provides": [
      "Locale"
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../plugin-sdk"
  }
}
