{
  "name": "@tuucho/plugin-tuucho-journal-admin",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Admin API journal. Complements Journal API.",
  "tuucho": {
    "id": "tuucho-journal-admin",
    "installPath": "tuucho/plugins/journal/admin/tuucho-journal-admin",
    "name": "API journal",
    "defaultEnabled": false,
    "dependsOn": [
      {
        "id": "tuucho-journal-api",
        "version": ">=1.0.0"
      }
    ],
    "provides": [
      "AdminPage"
    ],
    "permissions": [
      {
        "code": "api_log",
        "label": "API journal"
      }
    ],
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "adminNav": [
      {
        "id": "api-log",
        "group": "journal",
        "to": "/api-log",
        "permission": "api_log",
        "order": 20,
        "label": "API journal"
      }
    ],
    "kinds": [
      "generic"
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../plugin-sdk"
  }
}
