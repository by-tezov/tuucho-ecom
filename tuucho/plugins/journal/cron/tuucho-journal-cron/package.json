{
  "name": "@tuucho/plugin-tuucho-journal-cron",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Admin cron journals. Complements Journal API.",
  "tuucho": {
    "id": "tuucho-journal-cron",
    "installPath": "tuucho/plugins/journal/cron/tuucho-journal-cron",
    "name": "Cron journals",
    "defaultEnabled": false,
    "dependsOn": [
      {
        "id": "tuucho-journal-api",
        "version": ">=1.0.0"
      }
    ],
    "provides": [
      "AdminPage"
    ],
    "permissions": [
      {
        "code": "cron_logs",
        "label": "Cron journals"
      }
    ],
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "adminNav": [
      {
        "id": "cron-logs",
        "group": "journal",
        "to": "/crons",
        "permission": "cron_logs",
        "order": 10,
        "label": "Cron journals"
      }
    ],
    "kinds": [
      "generic"
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../plugin-sdk"
  }
}
