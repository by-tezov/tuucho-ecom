{
  "name": "@tuucho/plugin-tuucho-home-featured-locale-fr",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "French strings for home-featured. Enable with locale-fr for French UI; disable to keep this plugin in English.",
  "tuucho": {
    "id": "tuucho-home-featured-locale-fr",
    "installPath": "tuucho/plugins/home/featured/tuucho-home-featured-locale-fr",
    "name": "home-featured French",
    "kind": "locale",
    "defaultEnabled": true,
    "engines": {
      "core": ">=0.0.1 <1.0.0"
    },
    "dependsOn": [
      {
        "id": "tuucho-home-featured",
        "version": ">=1.0.0"
      }
    ],
    "provides": [
      "Locale"
    ]
  },
  "dependencies": {
    "@tuucho/plugin-sdk": "file:../../../../plugin-sdk"
  }
}
