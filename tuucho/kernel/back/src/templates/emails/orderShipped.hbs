{{> header}}
<h1 style="font-family:Georgia,'Times New Roman',serif;font-size:25px;font-weight:normal;color:#121212;margin:0 0 16px;line-height:1.2;">{{title}}</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#1a1a1a;line-height:1.65;margin:0 0 14px;">{{intro}}</p>
<div style="display:inline-block;background:#f6f6f6;border:1px solid #e1e1e1;border-radius:8px;padding:8px 16px;font-family:'Courier New',Courier,monospace;font-size:16px;font-weight:bold;color:#121212;letter-spacing:1px;margin-bottom:6px;">{{orderNumber}}</div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:19px;color:#121212;margin:24px 0 4px;">{{itemsHeading}}</div>
{{> orderItemsTable}}
{{#unless hidePrices}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:12px 0 8px;"><tr>
<td style="padding:10px 0 3px;border-top:1px solid #e1e1e1;font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#121212;font-weight:bold;">{{totalLabel}}</td>
<td style="padding:10px 0 3px;border-top:1px solid #e1e1e1;text-align:right;font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#121212;font-weight:bold;white-space:nowrap;">{{money total}}</td>
</tr></table>
{{/unless}}
{{> shippingAddress}}
{{#if siteUrl}}
<table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:18px auto;"><tr>
<td align="center" style="background:#121212;border-radius:28px;">
<a href="{{siteUrl}}" style="display:inline-block;padding:14px 32px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:28px;">{{siteLinkLabel}}</a>
</td></tr></table>
{{/if}}
{{> footer}}
