{
  "name": "tuucho-ecom-front",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "assets:optimize": "node scripts/optimizeStaticImages.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node --env-file-if-exists=.env/.public.env --env-file-if-exists=.env/.private.env scripts/build.mjs",
    "check:theme": "node scripts/checkThemeArchitecture.mjs && node scripts/checkThemeContrast.mjs",
    "check:contrast": "node scripts/checkThemeContrast.mjs",
    "check:architecture": "node scripts/checkArchitecture.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives && npm run check:theme && npm run check:architecture && npm run check:i18n && npm run check:api && npm run check:timings && npm run check:screens",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs}\" \"docs/**/*.md\" \"*.{ts,mjs,html,json,md}\" \".github/**/*.yml\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs}\" \"docs/**/*.md\" \"*.{ts,mjs,html,json,md}\" \".github/**/*.yml\"",
    "check:i18n": "node scripts/checkI18n.mjs",
    "i18n": "node scripts/i18n.mjs",
    "check:api": "node scripts/checkApiContract.mjs",
    "check:timings": "node scripts/checkTimings.mjs",
    "sync:screens": "node scripts/screenMap.mjs",
    "check:screens": "node scripts/screenMap.mjs --check",
    "check:context": "node scripts/checkContext.mjs --check",
    "context": "node scripts/checkContext.mjs",
    "check:bundle": "node scripts/checkBundle.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:context && npm run test:unit && npm run check:bundle",
    "sync:ratchets": "node scripts/checkArchitecture.mjs --fix"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@fontsource/noto-serif-thai": "^5.2.7",
    "@fontsource/pinyon-script": "^5.3.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tanstack/react-virtual": "^3.14.8",
    "libphonenumber-js": "^1.13.11",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "commander": "^15.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
