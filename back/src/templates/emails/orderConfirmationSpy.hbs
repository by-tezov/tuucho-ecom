<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;margin-bottom:16px;">
<tr><td style="color:#5c5c5c;padding-right:10px;">Commande</td><td style="font-weight:bold;color:#121212;">{{orderNumber}}</td></tr>
<tr><td style="color:#5c5c5c;padding-right:10px;">Client</td><td>{{customerEmail}}</td></tr>
<tr><td style="color:#5c5c5c;padding-right:10px;">ID utilisateur</td><td>{{userId}}</td></tr>
</table>
{{> orderItemsTable}}
{{> orderTotals}}
{{> footer}}
