{{> header}}
<h1 style="font-family:Georgia,'Times New Roman',serif;font-size:25px;font-weight:normal;color:#121212;margin:0 0 16px;line-height:1.2;">{{title}}</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#1a1a1a;line-height:1.65;margin:0 0 14px;">{{intro}}</p>
<div style="display:inline-block;background:#f6f6f6;border:1px solid #e1e1e1;border-radius:8px;padding:8px 16px;font-family:'Courier New',Courier,monospace;font-size:16px;font-weight:bold;color:#121212;letter-spacing:1px;margin-bottom:6px;">{{orderNumber}}</div>
<div style="font-family:Georgia,'Times New Roman',serif;font-size:19px;color:#121212;margin:24px 0 4px;">{{itemsHeading}}</div>
{{> orderItemsTable}}
{{> orderTotals}}
{{> shippingAddress}}
{{#if invoiceNotice}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 6px;background:#f6f6f6;border:1px solid #e1e1e1;border-radius:8px;"><tr><td style="padding:14px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#121212;line-height:1.6;">{{invoiceNotice}}</td></tr></table>
{{/if}}
{{#if loginSuggestion}}
<p style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#5c5c5c;line-height:1.6;margin:14px 0 4px;">{{loginSuggestion}}</p>
{{/if}}
{{#if ordersUrl}}
<table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:6px auto;"><tr>
<td align="center" style="background:#121212;border-radius:28px;">
<a href="{{ordersUrl}}" style="display:inline-block;padding:14px 32px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:28px;">{{loginLinkLabel}}</a>
</td></tr></table>
{{/if}}
{{#if integrityToken}}
<p style="font-family:'Courier New',monospace;font-size:11px;color:#5c5c5c;text-align:center;letter-spacing:.5px;margin:14px 0 0;">{{integrityLabel}} {{integrityToken}}</p>
{{/if}}
{{> footer}}
