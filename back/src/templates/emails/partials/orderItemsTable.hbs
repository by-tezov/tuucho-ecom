<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 4px;">
{{#each itemGroups}}
{{#if sectionLabel}}
<tr>
<td colspan="3" style="padding:14px 0 6px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="border-top:1px solid #e1e1e1;line-height:0;font-size:0;">&nbsp;</td>
<td style="padding:0 10px;white-space:nowrap;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;letter-spacing:0.06em;text-transform:uppercase;color:#5c5c5c;">{{sectionLabel}}</td>
<td style="border-top:1px solid #e1e1e1;line-height:0;font-size:0;">&nbsp;</td>
</tr></table>
</td>
</tr>
{{/if}}
<tr>
{{#if composition}}
<td style="padding:14px 0 10px;width:98px;vertical-align:top;">
<table role="presentation" cellpadding="0" cellspacing="3" border="0" style="background:#f6f6f6;border-radius:6px;">
{{#each composition.mosaicRows}}
<tr>{{#each cells}}<td width="16" height="21" style="width:16px;height:21px;padding:0;">{{#if photo}}<img src="{{photo}}" width="16" height="21" style="display:block;width:16px;height:21px;border-radius:3px;object-fit:cover;" alt="">{{else}}<div style="width:14px;height:19px;border-radius:3px;{{#if filled}}background:#fffdf8;border:1px solid #fffdf8;{{else}}border:1px dashed #cdb993;{{/if}}"></div>{{/if}}</td>{{/each}}</tr>
{{/each}}
</table>
</td>
<td style="padding:14px 8px 10px;vertical-align:top;">
{{else}}
<td style="padding:14px 0;width:52px;border-bottom:1px solid #f0e7d4;vertical-align:top;">
{{#if photo}}<img src="{{photo}}" width="44" height="44" style="border-radius:8px;object-fit:cover;display:block;border:1px solid #e1e1e1;" alt="">{{/if}}
</td>
<td style="padding:14px 8px;border-bottom:1px solid #f0e7d4;vertical-align:top;">
{{/if}}
{{#if shapeLabel}}<div style="display:inline-block;background:#f6f6f6;color:#121212;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;padding:3px 9px;border-radius:12px;margin-bottom:5px;margin-right:4px;">{{shapeLabel}}</div>{{/if}}{{#if lengthLabel}}<div style="display:inline-block;background:#f6f6f6;color:#121212;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;padding:3px 9px;border-radius:12px;margin-bottom:5px;">{{lengthLabel}}</div>{{/if}}{{#unless shapeLabel}}{{#if packLabel}}<div style="display:inline-block;background:#f6f6f6;color:#121212;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;padding:3px 9px;border-radius:12px;margin-bottom:5px;">{{packLabel}}</div>{{/if}}{{/unless}}
<div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#121212;">{{title}}{{#if isGift}} · {{../giftFreeLabel}}{{/if}}</div>
{{#if composition}}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#5c5c5c;margin-top:2px;">{{composition.nailCountLabel}}</div>{{/if}}
{{#each sizes}}
<div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#5c5c5c;margin-top:3px;">{{#if ../shapeKey}}{{../sizeLabel}} {{size}} · {{else}}{{#if ../nails}}{{../sizeLabel}} {{size}} · {{/if}}{{/if}}×{{quantity}}{{#unless ../../hidePrices}} : {{#if ../isGift}}{{../../giftFreeLabel}}{{else}}{{money lineTotal}}{{/if}}{{/unless}}</div>
{{/each}}
{{#if productUid}}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#5c5c5c;margin-top:4px;">{{refLabel}} {{productUid}}</div>{{/if}}
{{#if comment}}<div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#5c5c5c;margin-top:6px;padding:8px 10px;background:#fbf6ec;border-radius:6px;white-space:pre-wrap;"><strong>{{commentLabel}} :</strong> {{comment}}</div>{{/if}}
</td>
<td style="padding:14px 0;{{#unless composition}}border-bottom:1px solid #f0e7d4;{{/unless}}text-align:right;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#5c5c5c;white-space:nowrap;vertical-align:top;">{{#unless ../hidePrices}}{{#if isGift}}{{../giftFreeLabel}}{{else}}{{money groupTotal}}{{/if}}{{/unless}}</td>
</tr>
{{#if composition}}
<tr>
<td colspan="3" style="padding:0 0 12px;border-bottom:1px solid #f0e7d4;">
{{#each composition.hands}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;"><tr>
<td style="padding:0 10px 0 0;white-space:nowrap;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;letter-spacing:0.06em;text-transform:uppercase;color:#5c5c5c;">{{label}}</td>
<td width="100%" style="border-top:1px solid #e1e1e1;line-height:0;font-size:0;">&nbsp;</td>
</tr></table>
{{#each nails}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;"><tr>
<td style="width:44px;vertical-align:top;">{{#if photo}}<img src="{{photo}}" width="36" height="36" style="display:block;border-radius:6px;object-fit:cover;border:1px solid #e1e1e1;" alt="">{{/if}}</td>
<td style="vertical-align:top;font-family:Arial,Helvetica,sans-serif;">
<div style="font-size:13px;font-weight:bold;color:#121212;">{{title}}</div>
<div style="font-size:12px;color:#5c5c5c;margin-top:1px;">{{fingerLabel}}</div>
{{#if shapeLengthLabel}}<div style="font-size:12px;color:#5c5c5c;">{{shapeLengthLabel}}</div>{{/if}}
{{#if variationLabel}}<div style="font-size:12px;color:#5c5c5c;">{{variationLabel}}</div>{{/if}}
{{#if productUid}}<div style="font-size:12px;color:#5c5c5c;margin-top:2px;">{{../../refLabel}} {{productUid}}</div>{{/if}}
</td>
</tr></table>
{{/each}}
{{/each}}
</td>
</tr>
{{/if}}
{{/each}}
</table>
