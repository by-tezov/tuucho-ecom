{
  "name": "tezov-ecommerce-back",
  "private": true,
  "version": "1.0.9",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "docker compose --env-file .env/.private.env --env-file .env/dev/.private.env up -d && tsx scripts/devWithStripe.ts",
    "build": "node scripts/build.mjs",
    "backup-local": "tsx scripts/backupLocal.ts",
    "deploy": "tsx scripts/deploy.ts",
    "ops-gateway": "tsx src/opsGateway.ts",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/checkArchitecture.mjs",
    "check:docs": "node scripts/checkDocumentation.mjs",
    "check:sharecard": "node scripts/syncShareCard.mjs --check",
    "sync:sharecard": "node scripts/syncShareCard.mjs",
    "check": "npm run typecheck && npm run typecheck:tooling && npm run check:architecture && npm run check:docs && npm run check:schema && npm run check:sql && npm run check:routes && npm run check:errors && npm run check:env-docs && npm run check:api-reference && npm run check:module-docs && npm run check:policy && npm run check:contract && npm run check:context && npm run check:sharecard && npm run lint && npm run test:unit",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "seed": "tsx scripts/withOpsTunnel.ts seed",
    "product": "tsx scripts/withOpsTunnel.ts product",
    "library": "tsx scripts/withOpsTunnel.ts library",
    "library-user": "tsx scripts/withOpsTunnel.ts libraryUser",
    "library-nail": "tsx scripts/withOpsTunnel.ts libraryNail",
    "accessory": "tsx scripts/withOpsTunnel.ts accessory",
    "courier": "tsx scripts/withOpsTunnel.ts courier",
    "voucher": "tsx scripts/withOpsTunnel.ts voucher",
    "cart-rule": "tsx scripts/withOpsTunnel.ts cartRule",
    "payment-method": "tsx scripts/withOpsTunnel.ts paymentMethod",
    "payment-method-countries": "tsx scripts/withOpsTunnel.ts paymentMethodCountries",
    "courier-live-state": "tsx scripts/withOpsTunnel.ts courierLiveState",
    "sign-in-method": "tsx scripts/withOpsTunnel.ts signInMethod",
    "loyalty": "tsx scripts/withOpsTunnel.ts loyalty",
    "compose": "tsx scripts/withOpsTunnel.ts compose",
    "gift": "tsx scripts/withOpsTunnel.ts gift",
    "chat": "tsx scripts/withOpsTunnel.ts chat",
    "operation": "tsx scripts/withOpsTunnel.ts operation",
    "order": "tsx scripts/withOpsTunnel.ts order",
    "product-request": "tsx scripts/withOpsTunnel.ts productRequest",
    "user": "tsx scripts/withOpsTunnel.ts user",
    "faker": "tsx scripts/withOpsTunnel.ts faker",
    "test": "tsx scripts/test.ts",
    "healthz": "tsx scripts/healthz.ts",
    "edge-cache": "tsx scripts/edgeCache.ts",
    "log": "tsx scripts/withOpsTunnel.ts log",
    "sync:routes": "tsx scripts/routeInventory.ts --write",
    "check:routes": "tsx scripts/routeInventory.ts --check",
    "feature": "tsx scripts/feature.ts",
    "test:unit": "APP_TARGET=${APP_TARGET:-dev} node --import tsx --test --test-force-exit \"src-test/unit-test/**/*.test.ts\"",
    "test:coverage": "npm run test:coverage:back && npm run test:coverage:front && tsx scripts/writeReportHub.ts",
    "test:coverage:back": "APP_TARGET=${APP_TARGET:-dev} c8 --reporter=html --reporter=text --exclude-after-remap -o output/report/coverage/back node --import tsx --test --test-force-exit \"src-test/unit-test/**/*.test.ts\"",
    "test:coverage:front": "cd ../pamsurin-front && npx vitest run --coverage --coverage.reportOnFailure --coverage.reportsDirectory=../pamsurin-back/output/report/coverage/front",
    "scaffold": "tsx scripts/scaffoldFeature.ts",
    "sync:policy": "node scripts/syncPolicy.mjs",
    "check:policy": "node scripts/syncPolicy.mjs --check",
    "sync:contract": "node scripts/syncContract.mjs",
    "check:contract": "node scripts/syncContract.mjs --check",
    "context": "node scripts/featureContext.mjs",
    "sync:context": "node scripts/featureContext.mjs --update",
    "check:context": "node scripts/featureContext.mjs --check",
    "sync:api-reference": "node scripts/apiReference.mjs",
    "check:api-reference": "node scripts/apiReference.mjs --check",
    "sync:module-docs": "node scripts/moduleReadme.mjs",
    "check:module-docs": "node scripts/moduleReadme.mjs --check",
    "sync:schema": "tsx scripts/schemaSnapshot.ts --write",
    "check:schema": "tsx scripts/schemaSnapshot.ts --check",
    "table": "tsx scripts/table.ts",
    "check:sql": "node scripts/checkSql.mjs",
    "test:int": "APP_TARGET=${APP_TARGET:-dev} node --import tsx --test --experimental-test-isolation=none --test-force-exit \"src-test/int/**/*.int.test.ts\"",
    "test:int:reset": "tsx scripts/integrationDatabase.ts --drop",
    "typecheck:tooling": "tsc -p tsconfig.check.json",
    "where": "tsx scripts/where.ts",
    "sync:errors": "node scripts/errorCatalog.mjs",
    "check:errors": "node scripts/errorCatalog.mjs --check",
    "check:all": "npm run check && npm --prefix ../pamsurin-front run check",
    "sync:ratchets": "node scripts/checkArchitecture.mjs --fix",
    "change": "tsx scripts/change.ts",
    "check:env-docs": "node scripts/checkEnvDocs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "c8": "^12.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "jsqr": "^1.4.0",
    "oxlint": "^1.75.0",
    "patchright": "^1.61.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "argon2": "0.41.1",
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fontkit": "^2.0.4",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.24",
    "multer": "^2.3.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "stripe": "^22.4.0",
    "zod": "^4.6.1"
  }
}
