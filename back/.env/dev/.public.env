PUBLIC_DIR=./output/public
PRIVATE_DIR=./output/private

DEV_DIR=./output/dev
DEV_EMAIL_USER_DIR=/email-user
DEV_EMAIL_SPY_DIR=/email-spy
DEV_EMAIL_CHAT_DIR=/email-chat

URL_PUBLIC_MEDIA=http://localhost:3010/media
URL_API_BASE=http://localhost:3010
URL_FRONTEND_BASE=http://localhost:5174

SMTP_FROM_NAME_PREFIX=Dev:
SMTP_HOST=
SMTP_PORT=

EMAIL_NO_REPLY_FROM=
EMAIL_CONTACT_RECIPIENT=
EMAIL_ORDER_SPY_RECIPIENT=

SMTP_CHAT_HOST=
SMTP_CHAT_PORT=
SMTP_CHAT_USER=
SMTP_CHAT_PASSWORD=
EMAIL_CHAT_FROM=
EMAIL_CHAT_RECIPIENT=

MONDIAL_RELAY_API2_URL=https://connect-api-sandbox.mondialrelay.com/api/shipment
MONDIAL_RELAY_API1_URL=https://api.mondialrelay.com/WebService.asmx
MONDIAL_RELAY_PUBLIC_TRACKING_URL=https://www.mondialrelay.fr/suivi-de-colis/

RATE_OPS=60s:100000

# Local API/e2e suites create many browser contexts quickly. Each context
# bootstraps with /auth/refresh, so both auth creation and refresh limits must
# exceed a full serial Playwright run.
RATE_AUTH=60s:1000
RATE_AUTH_REFRESH=60s:1000
RATE_CONTACT_EMAIL=60s:1000

# Local development intentionally has no request-rate throttles. Production
# and preproduction retain the shared protective settings.
DISABLE_RATE_AUTH=true
DISABLE_RATE_CONTACT_EMAIL=true
DISABLE_RATE_AUTH_REFRESH=true
DISABLE_RATE_VOUCHER=true
DISABLE_RATE_CHECKOUT=true
DISABLE_RATE_PAYMENT=true
DISABLE_RATE_GALLERY=true
DISABLE_RATE_OPS=true
DISABLE_RATE_LOGIN=true
DISABLE_RATE_GIFT_PIN=true
DISABLE_RATE_GIFT_CREATE_EMAIL=true
DISABLE_RATE_GIFT_SHARE_CARD_UPDATE=true
DISABLE_RATE_GIFT_SHARE_CARD_DOWNLOAD=true
DISABLE_RATE_GIFT_SHARE_CARD_EMAIL=true
DISABLE_RATE_INVOICE_DOWNLOAD=true
DISABLE_RATE_INVOICE_EMAIL=true
DISABLE_RATE_LIMIT_SPY_COOLDOWN=true
DISABLE_EMAIL_CONFIRMATION_RESEND_COOLDOWN=true
DISABLE_EMAIL_CHANGE_COOLDOWN=true
DISABLE_AUTH_OTP_COOLDOWN=true
RATE_GIFT_PIN=60s:1000

LOGIN_LOCKOUT=1s:1000
PASSWORD_RESET_LIMIT=100000:100000
EMAIL_CONFIRMATION_RESEND_COOLDOWN=2m
EMAIL_CHANGE_COOLDOWN=5m
AUTH_OTP_COOLDOWN=1m
AUTH_OTP_MAX_ATTEMPTS=100000
AUTH_OTP_VERIFY_DELAY=1ms
