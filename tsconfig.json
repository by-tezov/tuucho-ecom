{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@kernel/front/*": ["kernel/front/src/*"],
      "@kernel/back/*": ["kernel/back/src/*"],
      "@tuucho/plugin-sdk": ["plugin-sdk/src/index.ts"]
    }
  },
  "include": [
    "plugins/**/*.ts",
    "plugins/**/*.tsx"
  ]
}
